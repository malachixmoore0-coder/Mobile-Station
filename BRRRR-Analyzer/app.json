{
  "expo": {
    "name": "BRRRR Scout",
    "slug": "brrrr-analyzer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F3D2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brrrrscout.app"
    },
    "android": {
      "package": "com.brrrrscout.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F3D2E"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "scheme": "brrrrscout",
    "experiments": {
      "baseUrl": "/mobile-station"
    }
  }
}
