# Copy to .env and fill in. Never commit the real .env.

# Safety: the bot refuses to place live orders unless this is exactly "true".
# Leave "false" while you're testing scanners/strategy logic.
LIVE_TRADING=false

# --- Venue toggles ---
ENABLE_TRADIER=false
ENABLE_DERIBIT=false
ENABLE_KALSHI=false

# --- Tradier (US equity/ETF options) ---
# Sandbox host is https://sandbox.tradier.com, production is https://api.tradier.com
TRADIER_BASE_URL=https://sandbox.tradier.com
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_ID=

# --- Deribit (crypto options: BTC/ETH) ---
# Test host is https://test.deribit.com, production is https://www.deribit.com
DERIBIT_BASE_URL=https://test.deribit.com
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# --- Kalshi (event/prediction markets) ---
# Demo host is https://demo-api.kalshi.co, production is https://api.elections.kalshi.com
# Verify current base URLs in Kalshi's docs before going live - they have changed before.
KALSHI_BASE_URL=https://demo-api.kalshi.co
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# --- Risk limits (see risk/manager.py) ---
MAX_POSITION_RISK_USD=200
MAX_DAILY_LOSS_USD=500
MAX_OPEN_POSITIONS=10

# --- Scanner thresholds ---
OPTIONS_IV_ZSCORE_THRESHOLD=2.5
PARITY_VIOLATION_MIN_USD=0.15
KALSHI_ARB_MIN_EDGE_CENTS=2

SCAN_INTERVAL_SECONDS=60
